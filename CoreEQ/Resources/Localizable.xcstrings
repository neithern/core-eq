            "state" : "translated",
            "value" : "±12 dB 图形均衡范围"
          }
        }
      }
    },
    "“%@” is an aggregate or multi-output device, which CoreEQ can’t equalize. Choose a single output device." : {
      "comment" : "Engine failure: the output device is made of several devices",
      "localizations" : {
        "zh-Hans" : {
