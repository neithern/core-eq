{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ Has Exclusive Access" : {
      "comment" : "Menu row: the app holding an output device to itself"
    },
    "%@ copy" : {
      "comment" : "Name of a duplicated preset, such as “Jazz copy”",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 副本"
          }
        }
      }
    },
    "%@ decibels" : {
      "comment" : "Gain, for VoiceOver, such as “+2.5 decibels”",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 分贝"
          }
        }
      }
    },
    "%@ downloaded" : {
      "comment" : "AutoEq catalog download progress, size unknown, such as “2 MB downloaded”",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载 %@"
          }
        }
      }
    },
    "%@ has exclusive access to “%@”, so its sound isn’t being equalized. The equalizer returns when %@ lets go." : {
      "comment" : "Engine status: an app holds an output device to itself",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has exclusive access to “%2$@”, so its sound isn’t being equalized. The equalizer returns when %3$@ lets go."
          }
        }
      }
    },
    "%@ hertz" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 赫兹"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "AutoEq catalog download progress, such as “2 MB of 5 MB”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ · %lld filters · Preamp %@" : {
      "comment" : "Import sheet heading: preset name, filter count, and output trim",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %#@filters@ · Preamp %3$@"
          },
          "substitutions" : {
            "filters" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filter"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filters"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %#@filters@ · 前级增益 %3$@"
          },
          "substitutions" : {
            "filters" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg 个滤波器"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, playing %@" : {
      "comment" : "Output device, for VoiceOver: device name and its preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, playing %2$@"
