    "The preset contains a filter type CoreEQ doesn’t support." : {
      "comment" : "Import error",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预设包含均衡器不支持的滤波器类型。"
          }
