    "The AutoEq catalog is empty." : {
      "comment" : "AutoEq error",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AutoEq 目录为空。"
          }
        }
      }
    },
    "The CoreEQ preset is damaged and can’t be read." : {
      "comment" : "Import error",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡器预设已损坏，无法读取。"
          }
        }
      }
    },
    "The audio device CoreEQ built around “%@” reported no output channels, so there’s nowhere to send the equalized sound." : {
      "comment" : "Engine failure: the output device has no channels",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡器基于“%@”创建的音频设备未报告任何输出声道，因此无法输出均衡后的声音。"
          }
        }
      }
    },
    "The change can’t be measured." : {
      "comment" : "AutoEq catalog notice: the change to the response is unknown",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法测量此项变化。"
          }
        }
      }
    },
    "The clipboard doesn’t contain a preset." : {
      "comment" : "Paste Preset error message",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板中没有预设。"
          }
        }
      }
    },
    "The correction uses filters CoreEQ can’t apply (%@)." : {
      "comment" : "AutoEq error: the filter type code follows in parentheses",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校正使用了均衡器无法应用的滤波器（%@）。"
          }
        }
      }
    },
    "The file is too large to be a preset." : {
      "comment" : "Import error",
