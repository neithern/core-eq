                  "value" : "%lld 个值超出 ±12 dB 图形均衡范围。"
                }
              }
            }
          }
        }
      }
    },
    "%lld values were adjusted to fit CoreEQ’s limits." : {
      "comment" : "Import alert: how many values CoreEQ changed",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
